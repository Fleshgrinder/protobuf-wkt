#!/usr/bin/env bash
set -Eeuo pipefail

info() {
  printf '\033[0;32m%s\033[0m\n' "$*"
}

readonly root_dir=${PWD}
readonly build_dir="${root_dir}/build"
readonly mirror_repo='Fleshgrinder/protobuf-wkt'
readonly upstream_repo='protocolbuffers/protobuf'

git config user.name "${GITHUB_USER:-Fleshgrinder}"
git config user.email "${GITHUB_EMAIL:-fleshgrinder@users.noreply.github.com}"

release_tags=$(
  gh api "repos/${upstream_repo}/releases" \
    --jq '.[].tag_name | select(test("^v([1-9][0-9]+\\.[0-9]+|3\\.[0-9]+\\.[0-9]+)$"))' \
    --paginate |
    sort -V -u
)

while IFS= read -r release; do
  [[ -z ${release} ]] && continue

  # shellcheck disable=SC2310
  if gh release view "${release}" --repo "${mirror_repo}" &>/dev/null; then
    info "${release} release exists"
  else
    # shellcheck disable=SC2310
    if gh api "repos/${mirror_repo}/branches/${release}" &>/dev/null; then
      info "${release} branch exists"
    else
      release_dir="${build_dir}/${release}"
      mkdir -p "${release_dir}"
      (
        cd "${release_dir}"

        cp -r "${root_dir}/.git" .git
        git checkout --orphan "${release}"
        git rm -rf .

        tarball="${build_dir}/${release}.tar.gz"
        gh api "repos/${upstream_repo}/tarball/${release}" >"${tarball}"
        tar -xf "${tarball}" --strip-components=2 --wildcards --no-wildcards-match-slash --exclude='*test*' '*/src/google/protobuf/*.proto'
        tar -xf "${tarball}" --strip-components=1 --wildcards --no-wildcards-match-slash '*/LICENSE'

        git add .
        git commit -qm "${release}"
        git push --set-upstream origin "${release}"

        info "created branch: ${release}"
      )
    fi

    gh api --method POST "repos/${mirror_repo}/releases" \
      -f "tag_name=${release}" \
      -f "target_commitish=${release}" \
      -f "name=${release}"
    info "created release: ${release}"
  fi
done <<<"${release_tags}"
